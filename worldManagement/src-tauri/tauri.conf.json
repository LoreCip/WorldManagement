{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "worldmanagement",
	"version": "0.1.0",
	"identifier": "com.fantasy.worldManagement",
	"plugins": {
		"updater": {
		"active": true,
		"endpoints": [
			"https://github.com/lorecip/WorldManagement/releases/latest/download/latest.json"
		],
		"dialog": true,
		"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzhGOTZCQTk4NTg0NkYKUldSdmhJV3BhL25Jb3BoeElIMk9wWjVXT1VOLzJNMXFKcCtreDlTV2hta0gyalBBRVJqdVlHT00K%"
		}
	},
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "worldmanagement",
				"width": 1200,
				"height": 800
			}
		],
		"security": {
			"csp": {
                "default-src": "'self' asset: https://asset.localhost",
                "img-src": "'self' asset: https://asset.localhost data:",
                "frame-src": "'self' asset: https://asset.localhost blob:",
                "object-src": "'self' asset: https://asset.localhost blob:"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$HOME/.local/share/com.fantasy.worldManagement/**",
                    "$APPDATA/com.fantasy.worldManagement/**"
                ]
            }
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}